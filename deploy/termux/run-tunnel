#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
PROJECT_DIR="${STUDY_RIVALS_DIR:-$HOME/study-rivals}"
ENV_FILE="$PROJECT_DIR/deploy/termux/env"
if [[ ! -r "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE. Add CLOUDFLARE_TUNNEL_TOKEN and chmod 600 it." >&2
  exit 1
fi
set -a
source "$ENV_FILE"
set +a
: "${CLOUDFLARE_TUNNEL_TOKEN:?CLOUDFLARE_TUNNEL_TOKEN is required}"
export TUNNEL_TOKEN="$CLOUDFLARE_TUNNEL_TOKEN"
unset CLOUDFLARE_TUNNEL_TOKEN
exec cloudflared tunnel --no-autoupdate run 2>&1
